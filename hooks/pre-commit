#!/usr/bin/env bash
#
# Pre-commit hook: rebuild docs/ when ui/src/ files are staged.
# Install: git config core.hooksPath hooks
#

# Check if any staged files are under ui/src/
if git diff --cached --name-only | grep -q '^ui/src/'; then
  echo "ui/src/ changes detected — rebuilding docs/..."

  (cd ui && npm run build) || {
    echo "ERROR: ui build failed. Commit aborted."
    exit 1
  }

  # Stage the rebuilt docs/ assets
  git add docs/

  echo "docs/ rebuilt and staged."
fi
